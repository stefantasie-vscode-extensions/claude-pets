{
  "_info": "Event -> animation mapping. Animations are addressed by the canonical ids from atlas.json (identical for all pets). 'then' = follows automatically, 'while' = loops until the next event.",
  "priorities": {
    "_info": "A higher number interrupts a lower one. Equal priority: the newer one wins. One-shot animations play to the end unless a higher priority arrives.",
    "interaction": 90,
    "attention": 80,
    "error": 70,
    "done": 60,
    "tool": 50,
    "thinking": 40,
    "reading": 35,
    "ambient": 20,
    "idle": 10
  },
  "hooks": {
    "SessionStart":        {"play": ["aufwachen", "hinlegen:reverse", "strecken", "umdrehen:reverse"], "then": "idle", "priority": "done"},
    "UserPromptSubmit":    {"play": ["aufmerksam"], "then": "nachdenken", "priority": "attention"},
    "UserPromptExpansion": {"play": ["pfoetchen_geben"], "then": "nachdenken", "priority": "ambient"},
    "PreToolUse": {
      "_byTool": {
        "Read|Grep|Glob|LS|NotebookRead": {"while": "schnueffeln", "priority": "tool"},
        "Edit|Write|MultiEdit|NotebookEdit": {"while": "buddeln", "priority": "tool"},
        "WebSearch|WebFetch": {"while": "lauschen", "priority": "tool"},
        "AskUserQuestion": {"while": "fragend", "priority": "attention"},
        "Bash": {
          "_byCommand": [
            {"match": "(^|\\s|&&|;)(npm|pnpm|yarn|bun)\\s+(run\\s+)?test|vitest|jest|pytest|go\\s+test|cargo\\s+test|phpunit|mvn\\s+test|gradle\\s+test", "while": "gespannt", "tag": "test"},
            {"match": "(npm|pnpm|yarn|bun)\\s+(install|i|add|ci)\\b|pip3?\\s+install|brew\\s+install|apt(-get)?\\s+install|cargo\\s+build|docker\\s+(build|pull)", "while": "ungeduldig", "tag": "install"},
            {"match": "git\\s+commit", "while": "nachdenken", "tag": "commit"},
            {"match": ".*", "while": "rennen", "tag": "bash"}
          ],
          "priority": "tool"
        },
        "*": {"while": "nachdenken", "priority": "thinking"}
      }
    },
    "PostToolUse": {
      "_byTag": {
        "test":   {"success": ["freuen"], "failure": ["traurig"]},
        "commit": {"success": ["freuen"]}
      },
      "then": "nachdenken", "priority": "tool"
    },
    "PostToolUseFailure": {"play": ["traurig"], "then": "nachdenken", "priority": "error"},
    "PostToolBatch":       {"while": "nachdenken", "priority": "thinking"},
    "PermissionRequest":   {"while": "bellen", "until": ["PreToolUse", "PostToolUse", "PermissionDenied", "Stop", "UserPromptSubmit"], "priority": "attention"},
    "PermissionDenied":    {"play": ["erschrecken"], "then": "nachdenken", "priority": "error"},
    "Notification": {
      "_byMatcher": {
        "agent_needs_input": {"while": "bellen", "priority": "attention"},
        "agent_completed":   {"play": ["freuen"], "then": "idle", "priority": "done"},
        "*":                 {"play": ["aufmerksam"], "then": "idle", "priority": "attention"}
      }
    },
    "MessageDisplay":      {"while": "mitlesen", "priority": "reading"},
    "SubagentStart":       {"play": ["verbeugen", "springen"], "then": "nachdenken", "priority": "ambient"},
    "SubagentStop":        {"play": ["knochen_bringen", "knochen_ablegen"], "then": "nachdenken", "priority": "ambient", "note": "knochen_bringen is a walking loop: let it run for 1.5 s while moving."},
    "TaskCreated":         {"play": ["knochen_vergraben"], "then": "nachdenken", "priority": "ambient"},
    "TaskCompleted":       {"play": ["knochen_ausgraben"], "then": "nachdenken", "priority": "ambient"},
    "Stop":                {"play": ["freuen"], "then": "idle", "priority": "done"},
    "StopFailure":         {"play": ["traurig"], "then": "idle", "priority": "error"},
    "PreCompact":          {"play": ["gaehnen"], "then": "liegen", "priority": "ambient"},
    "PostCompact":         {"play": ["schuetteln"], "then": "idle", "priority": "ambient"},
    "PostModelSwitch":     {"play": ["im_kreis_drehen", "umdrehen:reverse"], "then": "idle", "priority": "ambient"},
    "InstructionsLoaded":  {"play": ["nicken"], "then": "idle", "priority": "ambient"},
    "Elicitation":         {"while": "fragend", "priority": "attention"},
    "ElicitationResult":   {"play": ["nicken"], "then": "nachdenken", "priority": "ambient"},
    "CwdChanged":          {"action": "walkToRandomSpot", "priority": "ambient"},
    "DirectoryAdded":      {"action": "walkToRandomSpot", "priority": "ambient"},
    "WorktreeCreate":      {"play": ["buddeln"], "then": "idle", "priority": "ambient", "duration_ms": 1500},
    "WorktreeRemove":      {"play": ["zuschuetten"], "then": "idle", "priority": "ambient"},
    "SessionEnd":          {"play": ["hinlegen", "einschlafen"], "then": "schlafen", "priority": "done"}
  },
  "dom": {
    "_info": "Events the injected script detects directly in the Claude UI.",
    "typing":          {"while": "zuschauen", "stopAfterMs": 1500, "priority": "reading"},
    "escapeInterrupt": {"play": ["ohren_anlegen"], "then": "idle", "priority": "error"},
    "claudeBusy":      {"while": "nachdenken", "priority": "thinking", "note": "Fallback in case no hooks arrive: spinner/stop button visible."},
    "permissionDialog":{"while": "bellen", "priority": "attention", "note": "Fallback: permission dialog visible."}
  },
  "idle": {
    "_info": "Idle behaviour when nothing is going on.",
    "base": "sitzen",
    "blink": {"everyMs": [3000, 6000], "sequence": ["half", "closed", "half"], "frameMs": 80, "appliesTo": ["sitzen", "stehen", "liegen", "mit_ball_sitzen"]},
    "wander": {"chancePerSecond": 0.08, "sequence": ["umdrehen", "gehen", "stehen", "umdrehen:reverse"], "speedPxPerFrame": 1, "note": "Walks along the top edge of the prompt box to a random spot."},
    "randomActions": {"chancePerSecond": 0.02, "pick": ["verbeugen", "springen", "schuetteln", "gaehnen", "schnueffeln", "rennen"]},
    "lieDownAfterMs": 90000,
    "sleepAfterMs": 240000,
    "lieDown": ["umdrehen", "hinlegen"],
    "sleep": ["einschlafen", "schlafen"],
    "wakeUp": ["aufwachen", "hinlegen:reverse", "umdrehen:reverse"]
  },
  "interactions": {
    "hoverMove":      {"while": "streicheln", "note": "Mouse moves over the pet (at least 3 direction changes within 1 s)."},
    "click":          {"play": ["erschrecken:2-3", "freuen"], "then": "idle"},
    "feedButton":     {"action": "spawnBowl", "sequence": ["umdrehen", "gehen", "fressen"], "eatDurationMs": 4000},
    "treatButton":    {"action": "throwTreat", "sequence": ["leckerli_fangen"]},
    "toyDragThrow":   {"action": "throwToy", "sequence": ["umdrehen", "ball_lauern", "rennen", "ball_fangen", "mit_ball_gehen", "umdrehen:reverse", "mit_ball_sitzen"], "note": "Only show the toy during the interaction."},
    "ropeButton":     {"action": "holdRope", "while": "zerrspiel"},
    "circleOverLying":{"play": ["auf_den_ruecken_rollen"], "while": "bauch_kraulen", "end": ["auf_den_ruecken_rollen:reverse"]},
    "callDoubleClick":{"action": "walkTo", "sequence": ["umdrehen", "gehen", "umdrehen:reverse"]},
    "contextMenu": {
      "Sit": ["umdrehen:reverse", "sitzen"],
      "Lie down": ["umdrehen", "hinlegen", "liegen"],
      "Give paw": ["pfoetchen_geben"],
      "Spin": ["im_kreis_drehen", "umdrehen:reverse"],
      "Sleep": ["umdrehen", "hinlegen", "einschlafen", "schlafen"],
      "Change pet …": "openSpeciesPicker"
    }
  },
  "notation": {
    "name:reverse": "Play the animation backwards (e.g. hinlegen:reverse = get up, umdrehen:reverse = from side view to front view).",
    "name:2-3": "Play only frames 2 to 3 (1-based)."
  }
}
