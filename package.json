{
  "name": "claude-pets",
  "displayName": "Claude Pets",
  "publisher": "stefantasie",
  "version": "0.2.2",
  "description": "A pixel pet that lives on the Claude Code prompt box and reacts to what Claude is doing. Free and open source.",
  "icon": "assets/icon.png",
  "license": "MIT",
  "author": {
    "name": "Stefan Kley"
  },
  "homepage": "https://github.com/stefantasie-vscode-extensions/claude-pets#readme",
  "bugs": {
    "url": "https://github.com/stefantasie-vscode-extensions/claude-pets/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stefantasie-vscode-extensions/claude-pets.git"
  },
  "sponsor": {
    "url": "https://ko-fi.com/stefantasie/tiers"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "pet",
    "pixel art",
    "virtual pet",
    "companion"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [],
  "contributes": {
    "commands": [
      {
        "command": "claudePets.enable",
        "title": "Enable",
        "category": "Claude Pets"
      },
      {
        "command": "claudePets.disable",
        "title": "Disable",
        "category": "Claude Pets"
      },
      {
        "command": "claudePets.reapply",
        "title": "Reapply",
        "category": "Claude Pets"
      },
      {
        "command": "claudePets.chooseSpecies",
        "title": "Choose Pet…",
        "category": "Claude Pets"
      },
      {
        "command": "claudePets.installHooks",
        "title": "Install Hooks",
        "category": "Claude Pets"
      },
      {
        "command": "claudePets.removeHooks",
        "title": "Remove Hooks",
        "category": "Claude Pets"
      },
      {
        "command": "claudePets.diagnose",
        "title": "Show Diagnostics",
        "category": "Claude Pets"
      }
    ],
    "configuration": {
      "title": "Claude Pets",
      "properties": {
        "claudePets.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the pet. Turning this off removes the injection from Claude Code and the hooks.",
          "order": 0,
          "scope": "application"
        },
        "claudePets.species": {
          "type": "string",
          "default": "dog",
          "enum": [
            "dog",
            "cat",
            "fox",
            "raccoon",
            "panda",
            "monkey",
            "rabbit",
            "frog",
            "robot",
            "crab",
            "squirrel",
            "turtle",
            "random"
          ],
          "enumItemLabels": [
            "Dog",
            "Cat",
            "Fox",
            "Raccoon",
            "Panda",
            "Monkey",
            "Rabbit",
            "Frog",
            "Robot",
            "Crab",
            "Squirrel",
            "Turtle",
            "Random"
          ],
          "enumDescriptions": [
            "Dog",
            "Cat",
            "Fox",
            "Raccoon",
            "Panda",
            "Monkey",
            "Rabbit",
            "Frog",
            "Robot",
            "Crab",
            "Squirrel",
            "Turtle",
            "A different pet on every start"
          ],
          "description": "Which pet sits on the prompt box.",
          "order": 1,
          "scope": "application"
        },
        "claudePets.scale": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Pixel size: one sprite pixel equals this many CSS pixels (1–4).",
          "order": 2,
          "scope": "application"
        },
        "claudePets.showButtons": {
          "type": "boolean",
          "default": true,
          "description": "Show a toolbar with bowl, treat, toy and rope when hovering over the pet.",
          "order": 3,
          "scope": "application"
        },
        "claudePets.hooks.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Register Claude Code hooks in `~/.claude/settings.json` so the pet reacts to Claude. Turning this off removes the hooks.",
          "order": 4,
          "scope": "application"
        },
        "claudePets.idle.wander": {
          "type": "boolean",
          "default": true,
          "description": "Wander around the prompt box while idle.",
          "order": 5,
          "scope": "application"
        },
        "claudePets.idle.sleepAfterMinutes": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 120,
          "description": "The pet falls asleep after this many minutes without activity.",
          "order": 6,
          "scope": "application"
        },
        "claudePets.opacityOnHover": {
          "type": "number",
          "default": 0.35,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity while the mouse rests over the pet and the prompt box has focus (so text behind it stays readable).",
          "order": 7,
          "scope": "application"
        },
        "claudePets.reduceMotion": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Follow the system setting \"reduce motion\"",
            "No wandering and no random actions",
            "Full motion"
          ],
          "description": "Reduce motion. Reactions to events are kept.",
          "order": 8,
          "scope": "application"
        },
        "claudePets.patchCsp": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Extend the Content Security Policy of Claude Code with `connect-src http://127.0.0.1:*` so hook events reach the pet. Off = DOM-only mode without hook reactions.",
          "order": 9,
          "scope": "application"
        },
        "claudePets.debug": {
          "type": "boolean",
          "default": false,
          "description": "Verbose logging in the \"Claude Pets\" output channel (and in ~/.claude-pets/debug.log).",
          "order": 10,
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "install-local": "code --install-extension claude-pets-0.2.2.vsix --force",
    "vscode:prepublish": "npm run build",
    "vscode:uninstall": "node ./dist/uninstall.js",
    "make-banner": "node scripts/make-banner.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
